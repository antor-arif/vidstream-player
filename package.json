{
  "name": "vidstream-player",
  "version": "2.0.0",
  "description": "Production-ready video player SDK — HLS, LL-HLS, DASH, P2P (WebRTC), React, Vue, Angular, Web Component, config-driven theming, playlist sidebar, chapters, seek thumbnails, PiP, mini player, volume animation, touch gestures, progress tracking, analytics plugin, full TypeScript",
  "main": "dist/player.umd.js",
  "module": "dist/player.esm.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/player.esm.mjs",
      "require": "./dist/player.umd.js",
      "default": "./dist/player.esm.js"
    },
    "./webcomponent": {
      "types": "./dist/types/webcomponent.d.ts",
      "import": "./dist/player.webcomponent.mjs",
      "require": "./dist/player.webcomponent.cjs",
      "default": "./dist/player.webcomponent.js"
    },
    "./react": {
      "types": "./dist/types/react-wrapper.d.ts",
      "import": "./dist/react-wrapper.mjs",
      "require": "./dist/react-wrapper.cjs",
      "default": "./dist/react-wrapper.js"
    },
    "./styles": {
      "types": "./dist/types/styles.d.ts",
      "default": "./dist/player.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepack": "",
    "postpack": "",
    "publish:npm": "npm run build && npm publish --access public"
  },
  "keywords": [
    "video-player",
    "hls-player",
    "dash-player",
    "react-video-player",
    "vue-video-player",
    "angular-video-player",
    "web-component-video-player",
    "adaptive-streaming",
    "hls",
    "dash",
    "streaming",
    "vod-player",
    "live-streaming-player",
    "e-learning",
    "playlist-player",
    "chapters",
    "picture-in-picture",
    "mini-player",
    "touch-gestures",
    "analytics",
    "typescript",
    "customizable-video-player",
    "video-sdk",
    "web-component",
    "react",
    "vue",
    "angular",
    "hlsjs",
    "dashjs",
    "p2p",
    "webrtc",
    "low-latency",
    "ll-hls"
  ],
  "author": "Md. Arifur Rahman",
  "license": "MIT",
  "devDependencies": {
    "@swarmcloud/hls": "^2.18.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "dashjs": "^5.2.0",
    "eslint": "^8.56.0",
    "hls.js": "^1.6.15",
    "jsdom": "^25.0.1",
    "p2p-media-loader-hlsjs": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "dashjs": ">=4.0.0",
    "hls.js": ">=1.6.0",
    "p2p-media-loader-hlsjs": ">=4.0.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "@swarmcloud/hls": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "dashjs": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "p2p-media-loader-hlsjs": {
      "optional": true
    },
    "@swarmcloud/hls": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antor-arif/vidstream-player.git"
  }
}
